<li class="todo-item flex items-center justify-between gap-3 rounded-xl border border-gray-100 bg-white px-4 py-3 transition-colors <%= done ? 'bg-gray-50/60' : 'hover:border-emerald-200' %>"
    hx-target="closest .todo-item"
    hx-indicator="#todo-list-region">
    <span class="min-w-0 flex-1 text-sm <%= done ? 'text-gray-400 line-through' : 'text-gray-800' %>">
        <%= text %>
    </span>
    <span class="text-sm <%= done ? 'text-gray-400 line-through' : 'text-gray-800' %>">
        <%= createTimeFormat %>
    </span>
    <span class="text-sm <%= done ? 'text-gray-400 line-through' : 'text-gray-800' %>">
        <%= modifyTimeFormat %>
    </span>
    <div class="flex shrink-0 items-center gap-2">
        <%#
            button 的 hx-target 和 hx-indicator 从 li 上继承 
        %>
        <button class="<%= done ? 'btn-soft' : 'btn-primary' %>"
            data-confirm="<%= done ? t('confirm.undo_msg') : t('confirm.mark_msg') %>"
            data-confirm-title="<%= done ? t('confirm.undo_title') : t('confirm.mark_title') %>"
            data-confirm-confirm="<%= done ? t('confirm.undo_btn') : t('confirm.mark_btn') %>"
            data-confirm-cancel="<%= t('confirm.cancel_btn') %>"
            data-confirm-variant="info" 
            hx-post="/page/todos/<%= id %>/toggle" hx-swap="outerHTML">
            <%= done ? '↩ ' + t('confirm.undo_btn') : '✓ ' + t('confirm.mark_btn') %>
        </button>
        <button class="btn-danger" data-confirm="<%= t('confirm.delete_msg') %>"
            data-confirm-title="<%= t('confirm.delete_title') %>"
            data-confirm-confirm="<%= t('confirm.delete_accept') %>"
            data-confirm-cancel="<%= t('confirm.cancel_btn') %>"
            data-confirm-variant="danger"
            hx-delete="/page/todos/<%= id %>" hx-swap="delete">
            ✕ <%= t('confirm.delete_btn') %>
        </button>
    </div>
</li>
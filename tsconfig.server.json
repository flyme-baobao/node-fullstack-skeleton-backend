{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2022"],
        "noEmit": false,
        "outDir": "dist-server",
        "rootDir": "server/src",
        "sourceMap": true,
        "types": ["node"]
    },
    "include": ["server/src", "index.d.ts"],
    "exclude": ["server/src/legacy"]
}
# ================= 端口配置（双端口模式，env 驱动） =================
SERVER_PORT=3000
VITE_PORT=5173

# ================= PostgreSQL 数据库配置【团队模板，复制为.env后填写真实值】 =================
DB_USER=
DB_PASSWORD=
DB_NAME=
# 访问数据库地址
# ⚠️ HOST 取值取决于 Node 进程运行位置，不是数据库容器地址：
#   [Node在docker容器] 填服务名 postgres → docker-compose.local.yml 全量容器模式（Node+Postgres+Redis）
#   [Node在宿主机 npm run dev] 填 127.0.0.1（或 localhost）→ 走宿主机端口映射连接，develop 环境需在Node侧自行适配
DB_HOST=
DB_PORT=5432

# Prisma完整数据库连接串，复制到.env再启用
# DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# ================= 连接池参数（db.config.ts 读取） =================
# 连接池最大连接数
DB_POOL_MAX=10
# 连接空闲时间（毫秒）超时释放
DB_IDLE_TIMEOUT_MS=30000
# 连接获取超时（毫秒）
DB_CONNECTION_TIMEOUT_MS=5000

# ================= Redis7缓存配置 =================
REDIS_PASSWORD=
# 访问Redis地址
# ⚠️ HOST 取值遵循与 DB_HOST 相同的规则（取决于 Node 进程运行位置）：
#   [Node在docker容器内] 填服务名 redis（docker-compose.local.yml 全容器模式）
#   [Node在宿主机 npm run dev] 填 127.0.0.1（或 localhost）→ 走宿主机端口映射，develop 环境需在宿主机侧自行适配
REDIS_HOST=
REDIS_PORT=6379

# Redis连接示例，业务按需使用
# REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0"

# 运行环境：development / production
NODE_ENV=
# 应用时区：Node 进程读取（logger.ts 的 tsLocal/时间格式化用）
# 取值 IANA 时区名，如 Asia/Shanghai（东八区）、UTC、America/New_York
TZ='Asia/Shanghai'
# Compose 部署健康等待超时（秒），CI 部署（github-ci.yml / gitee-ci.yml）中使用，workflow env 兜底 60
COMPOSE_WAIT_TIMEOUT=60

# ================= 测试 override（docker-compose.test.yml 用，仅本地） =================
# 用途：拉取「已 push 的镜像」跑整套生产栈，纯验证镜像可用性，不构建。
# 使用：docker compose -f docker-compose.yml -f docker-compose.test.yml up -d
# TEST_IMAGE_NAME=                                     # 完整镜像名（含 tag），如 registry.example.com/repo:tag

# ================================================================
# ===================== CI 环境变量总览（平台无关） =====================
# 说明：ci 用的变量只分两类，请看 workflow 顶部注释保持一致。
# ① env 层（非敏感，写死或自动生成，无需配置）
#    IMAGE_NAME / IMAGE_TAG / COMPOSE_WAIT_TIMEOUT
# ② Secrets（敏感值）——务必在平台后台配置，不要写进 .env
#    GitHub：Settings → Secrets and variables → Actions
#    Gitee ：流水线 → Gitee Go → Secrets
# ================================================================
#
# ------- ② ACR 登录（必填 Secrets） -------
# REGISTRY_USER=                              # 阿里云ACR登录账号（RAM子账号/主账号）
# REGISTRY_PASSWORD=                          # 阿里云ACR登录密码
# ------- 生产 SSH（必填 Secrets） -------
# DEPLOY_SERVER_HOST=                         # SSH 生产服务器IP/域名
# DEPLOY_PATH=                                # 服务器部署目录（含 compose 指定文件）
# DEPLOY_SSH_PRIVATE_KEY=                     # 生产服务器SSH私钥
# ------- DB/Redis（必填 Secrets） -------
# DB_USER=DB_PASSWORD=DB_NAME=                # 数据库账号/密码/库名
# REDIS_PASSWORD=                             # Redis 密码
# ------- compose 插值运行期（可选，缺省默认值，CI 兜底） -------
# SERVER_PORT=                                # 服务端口，默认 3000
# NODE_ENV=                                   # 运行环境，默认 production
# TZ='Asia/Shanghai'                          # 应用时区，默认 Asia/Shanghai
# DB_POOL_MAX=10                              # 连接池最大连接数，默认 10
# DB_IDLE_TIMEOUT_MS=30000                    # 空闲超时（毫秒），默认 30000
# DB_CONNECTION_TIMEOUT_MS=5000               # 连接获取超时（毫秒），默认 5000
# ================================================================